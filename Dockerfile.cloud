# syntax=docker/dockerfile:1
# Cloud deploy: OpenAI Whisper + embeddings (no local ML stack).
FROM node:22-bookworm-slim AS client
WORKDIR /build
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
RUN VITE_API_BASE= npm run build

FROM python:3.11-slim-bookworm
WORKDIR /app
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir -r requirements-cloud.txt
COPY server/app ./app
COPY --from=client /build/dist ./client/dist
RUN mkdir -p /data
ENV DATA_DIR=/data
ENV PYTHONPATH=/app
ENV WHISPER_PROVIDER=openai
ENV EMBED_PROVIDER=openai
ENV WHISPER_MODEL=whisper-1
ENV COOKIE_SECURE=true
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
