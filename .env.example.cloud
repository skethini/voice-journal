# Cloud mode — copy to .env on Render / Fly / Railway
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# No local Whisper/torch — audio transcript via OpenAI API (paid per minute, cheap)
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1
EMBED_PROVIDER=openai

KEEP_AUDIO=false
DATA_DIR=/data
SESSION_SECRET=
PASSCODE_HASH=
PUBLIC_URL=https://your-app.onrender.com

COOKIE_SECURE=true
TIMEZONE=America/Los_Angeles
